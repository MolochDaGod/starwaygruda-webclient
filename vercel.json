{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\.glb",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }
      ]
    },
    {
      "source": "/(.*)\.fbx",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "Cross-Origin-Resource-Policy", "value": "cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index-mmo.html" },
    { "source": "/game", "destination": "/index-mmo.html" },
    { "source": "/play", "destination": "/index-mmo.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/crafting", "destination": "/crafting.html" }
  ],
  "redirects": [
    { "source": "/mmo", "destination": "/", "permanent": true },
    { "source": "/space", "destination": "/", "permanent": true },
    { "source": "/ground", "destination": "/", "permanent": true }
  ]
}
