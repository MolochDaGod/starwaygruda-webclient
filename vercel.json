{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index-mmo.html"
    },
    {
      "source": "/game",
      "destination": "/index-mmo.html"
    },
    {
      "source": "/play",
      "destination": "/index-mmo.html"
    }
  ],
  "redirects": [
    {
      "source": "/mmo",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/space",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ground",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index-landing.html",
      "destination": "/",
      "permanent": true
    }
  ]
}
